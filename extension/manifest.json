
{
  "manifest_version": 3,
  "name": "LimitGuard - AI Context Firewall",
  "version": "1.0.0",
  "description": "Protect prompts before they reach AI websites.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LimitGuard",
    "default_popup": "popup.html"
  }
}
